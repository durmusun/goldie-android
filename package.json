{
  "name": "goldie-android",
  "version": "0.2.1",
  "description": "Google Play screenshot, feature graphic, listing package, and compliance automation driven by argent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/durmusun/goldie-android.git"
  },
  "homepage": "https://github.com/durmusun/goldie-android#readme",
  "bugs": {
    "url": "https://github.com/durmusun/goldie-android/issues"
  },
  "keywords": [
    "google-play",
    "android",
    "screenshots",
    "feature-graphic",
    "play-store",
    "emulator",
    "argent",
    "claude-skill"
  ],
  "type": "module",
  "bin": {
    "goldie-android": "dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "LICENSE",
    "README.md",
    "assets/favicon.png",
    "assets/ATTRIBUTION.md",
    "assets/17-pro-*.png",
    "assets/fonts/",
    "studio/dist/",
    "skills/",
    "goldie.config.example.ts"
  ],
  "engines": {
    "node": ">=20.12.0"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "goldie-android": "bun src/cli.ts",
    "doctor": "bun src/cli.ts doctor",
    "capture": "bun src/cli.ts capture",
    "frame": "bun src/cli.ts frame",
    "preview": "bun src/cli.ts preview",
    "all": "bun src/cli.ts all",
    "studio": "bun src/cli.ts manifest && cd studio && bun install --silent && bun run dev",
    "studio:build": "bun run build:studio",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "check": "biome check --write .",
    "check:ci": "biome check .",
    "build": "bun run build:studio && bun run build:cli",
    "build:cli": "rm -rf dist && bun build src/cli.ts src/index.ts --outdir dist --target node --packages external --sourcemap=linked && tsc -p tsconfig.build.json",
    "build:studio": "cd studio && bun install --silent && bun run build",
    "prepublishOnly": "bun run check:ci && bun test && bun run build"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.8",
    "@swmansion/argent": "^0.22.0",
    "jiti": "^2.6.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/bun": "^1.4.0",
    "typescript": "5.9.3"
  }
}
